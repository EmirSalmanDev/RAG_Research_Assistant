            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Published To"
            }
          },
          {
            "description": "run the cross-encoder (slow on CPU); default: RERANK_ENABLED, off",
            "in": "query",
            "name": "rerank",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "run the cross-encoder (slow on CPU); default: RERANK_ENABLED, off",
              "title": "Rerank"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
