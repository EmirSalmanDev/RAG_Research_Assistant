# Copy to .env and fill in. Never commit .env.

# --- Stores (defaults suit running the backend natively; compose overrides the hosts) ---
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# --- External services (OPENAI_API_KEY is needed for embeddings; set a monthly limit) ---
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
GITHUB_TOKEN=
S2_API_KEY=

# --- Ingestion (optional: the defaults below are used when these are unset) ---
# arXiv categories for the daily fetch and the backfill, as a JSON list.
# ARXIV_CATEGORIES=["cs.CL","cs.LG","cs.AI","cs.IR"]
# Changing the embedding model or size means re-embedding and a new collection.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# EMBEDDING_PRICE_PER_1M=0.02
# EMBEDDING_BATCH_SIZE=100
# SPARSE_MODEL=Qdrant/bm25
# QDRANT_COLLECTION=chunks
# CHUNK_TOKENS=512
# CHUNK_OVERLAP=64
# CHUNK_MIN_TOKENS=64
# CHUNK_HARD_MAX_TOKENS=2048
# Where tiktoken caches its tokenizer file (default ~/.cache/tiktoken; set in Docker/CI).
# TIKTOKEN_CACHE_DIR=

# --- Retrieval (optional: the defaults below are used when these are unset) ---
# Search mode: dense, bm25 or hybrid. The prefetch limit is per list in hybrid mode;
# the candidates are what the reranker rescores; a per-paper cap of 0 switches it off.
# RERANK_ENABLED is the default for GET /search (a request can pass rerank=true); it is
# off because reranking 50 candidates takes about 20 s on a laptop CPU. The retrieval
# evaluation sets rerank per configuration and ignores it.
# SEARCH_MODE=hybrid
# SEARCH_PREFETCH_LIMIT=50
# SEARCH_RRF_K=60
# SEARCH_CANDIDATES=50
# RERANK_ENABLED=false
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANK_BATCH_SIZE=16
# MAX_CHUNKS_PER_PAPER=3
# Where `make fetch-reranker` puts the model; the app only ever reads it from there.
# FASTEMBED_CACHE_DIR=~/.cache/fastembed
