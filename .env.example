# Copy to .env and fill in. Never commit .env.

# --- Stores (defaults suit running the backend natively; compose overrides the hosts) ---
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# --- External services (OPENAI_API_KEY is needed for embeddings; set a monthly limit) ---
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
GITHUB_TOKEN=
S2_API_KEY=

# --- Ingestion (optional: the defaults below are used when these are unset) ---
# arXiv categories for the daily fetch and the backfill, as a JSON list.
# ARXIV_CATEGORIES=["cs.CL","cs.LG","cs.AI","cs.IR"]
# The daily fetch reads from the last run's cursor minus 4 days, but never more than this many
# days back; a longer gap is recorded on the run and left to `make backfill`.
# ARXIV_DAILY_MAX_WINDOW_DAYS=7
# Retries of the daily chain's fetch_arxiv and fetch_hf_daily steps: retry n waits
# FIRST_DELAY_MIN * FACTOR^(n-1) minutes +/- JITTER (2, 6 and 18 min +/-20 %). The longest
# delay must stay below 60 min (the broker's visibility timeout), or the app refuses to start.
# DAILY_FETCH_RETRIES=3
# DAILY_FETCH_RETRY_FIRST_DELAY_MIN=2
# DAILY_FETCH_RETRY_FACTOR=3
# DAILY_FETCH_RETRY_JITTER=0.2
# Same-day catch-up: at these times (HH:MM Europe/Istanbul, comma-separated, each later than
# 07:00) Beat sends the daily chain again, but only if no arXiv run has succeeded since 07:00
# and no chain is still running. Its papers reach the next day's digest. Empty = off.
# DAILY_CATCHUP_TIMES=13:00,19:00
# Changing the embedding model or size means re-embedding and a new collection.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# EMBEDDING_PRICE_PER_1M=0.02
# EMBEDDING_BATCH_SIZE=100
# SPARSE_MODEL=Qdrant/bm25
# QDRANT_COLLECTION=chunks
# CHUNK_TOKENS=512
# CHUNK_OVERLAP=64
# CHUNK_MIN_TOKENS=64
# CHUNK_HARD_MAX_TOKENS=2048
# Where tiktoken caches its tokenizer file (default ~/.cache/tiktoken; set in Docker/CI).
# TIKTOKEN_CACHE_DIR=

# --- Retrieval (optional: the defaults below are used when these are unset) ---
# Search mode: dense, bm25 or hybrid. The prefetch limit is per list in hybrid mode;
# the candidates are what the reranker rescores; a per-paper cap of 0 switches it off.
# RERANK_ENABLED is the default for GET /search (a request can pass rerank=true); it is
# off because reranking 50 candidates takes about 20 s on a laptop CPU. The retrieval
# evaluation sets rerank per configuration and ignores it.
# SEARCH_MODE=hybrid
# SEARCH_PREFETCH_LIMIT=50
# SEARCH_RRF_K=60
# SEARCH_CANDIDATES=50
# RERANK_ENABLED=false
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANK_BATCH_SIZE=16
# MAX_CHUNKS_PER_PAPER=3
# Generated analysis chunks per paper, capped apart from the paper's own text: 0 leaves
# them out, -1 counts them toward MAX_CHUNKS_PER_PAPER like any chunk.
# MAX_ANALYSIS_CHUNKS_PER_PAPER=1
# Where `make fetch-reranker` puts the model; the app only ever reads it from there.
# FASTEMBED_CACHE_DIR=~/.cache/fastembed

# --- Chat (optional: the defaults below are used when these are unset) ---
# One model for every chat call; the prices only feed llm_usage.cost_usd.
# RERANK_ENABLED above is also the default for chat (off).
# CHAT_MODEL=gpt-4o-mini
# CHAT_PRICE_IN_PER_1M=0.15
# CHAT_PRICE_OUT_PER_1M=0.60
# CHAT_TEMPERATURE=0.0
# CHAT_MAX_OUTPUT_TOKENS=1000
# CHAT_MAX_OUTPUT_TOKENS_EXPLAIN=1600
# CHAT_HISTORY_MESSAGES=6
# CHAT_SOURCES=8
# Stage switches (each can be turned off to measure what it adds).
# CONDENSE_ENABLED=true
# PLAN_ENABLED=true
# PLAN_REPHRASINGS_ENABLED=true
# VERIFY_ENABLED=true

# --- Daily digest (optional: the defaults below are used when these are unset) ---
# The settings page overrides DIGEST_SIZE, FULLTEXT_TOP_N and the categories (stored in the
# database). The relevance weights and the Save / Dismiss steps are described in docs/adr/0009.
# DIGEST_SIZE=20
# DIGEST_WINDOW_DAYS=7
# DIGEST_TRENDING_UPVOTES=10
# FULLTEXT_TOP_N=20
# INTEREST_SAVE_DELTA=0.10
# INTEREST_DISMISS_DELTA=-0.05

# --- Frontend container (optional; only the compose `frontend` profile reads it) ---
# Where the container's /api proxy sends requests. Next fixes it when the image is built, so
# a change needs `docker compose --profile frontend build frontend`. The default is the API's
# compose service name; the published frontend image is built with it too.
# FRONTEND_API_ORIGIN=http://api:8000
